generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Priority {
  id        String   @id @default(cuid())
  label     String   @unique
  color     String
  sortOrder Int      @default(0)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Status {
  id        String          @id @default(cuid())
  name      String          @unique
  color     String
  sortOrder Int             @default(0)
  tasks     Task[]
  fromHistory StatusHistory[] @relation("StatusHistoryFrom")
  toHistory   StatusHistory[] @relation("StatusHistoryTo")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String   @default("")
  nickname   String   @unique
  email      String   @default("")
  employeeId String   @default("")
  /// Jira-style role: viewer | member | administrator
  role       String   @default("member")
  color      String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  tasks      Task[]   @relation("TaskAssignee")
  ownedTasks Task[]   @relation("TaskOwner")
  taskAssignments TaskAssignee[]
  subtaskAssignments SubtaskAssignee[]
  comments   TaskComment[]
  watches    TaskWatcher[]
  notifications Notification[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TaskTypeOption {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  color       String   @default("#1E3A5F")
  theme       String   @default("clean")
  /// JSON map of status name → WIP limit (0 = unlimited)
  wipLimitsJson String @default("{}")
  sortOrder   Int      @default(0)
  tasks       Task[]
  savedFilters SavedFilter[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// User-authored color themes (built-ins live in code/CSS).
model ColorTheme {
  id          String   @id
  label       String
  description String   @default("")
  /// JSON ThemePalette
  paletteJson String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String          @id @default(cuid())
  name        String
  description String          @default("")
  remarks     String          @default("")
  source      String          @default("")
  taskType    String          @default("Back End")
  startDate   DateTime?
  endDate     DateTime?
  uatDate     DateTime?
  prdDate     DateTime?
  sortOrder   Int             @default(0)
  projectId   String
  priorityId  String
  statusId    String
  assigneeId  String?
  ownerId     String?
  project     Project         @relation(fields: [projectId], references: [id])
  priority    Priority        @relation(fields: [priorityId], references: [id])
  status      Status          @relation(fields: [statusId], references: [id])
  assignee    TeamMember?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  owner       TeamMember?     @relation("TaskOwner", fields: [ownerId], references: [id])
  statusHistory       StatusHistory[]
  postReleaseChanges  PostReleaseChange[]
  comments            TaskComment[]
  linksFrom           TaskLink[]          @relation("TaskLinkFrom")
  linksTo             TaskLink[]          @relation("TaskLinkTo")
  watchers            TaskWatcher[]
  notifications       Notification[]
  subtasks            Subtask[]
  assignments         TaskAssignee[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TaskComment {
  id             String      @id @default(cuid())
  taskId         String
  body           String
  authorId       String?
  authorNickname String      @default("")
  task           Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         TeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([taskId, createdAt])
}

model TaskLink {
  id         String   @id @default(cuid())
  fromTaskId String
  toTaskId   String
  /// blocks | relates
  linkType   String   @default("relates")
  fromTask   Task     @relation("TaskLinkFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask     Task     @relation("TaskLinkTo", fields: [toTaskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromTaskId, toTaskId, linkType])
  @@index([fromTaskId])
  @@index([toTaskId])
}

model TaskWatcher {
  id           String     @id @default(cuid())
  taskId       String
  teamMemberId String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([taskId, teamMemberId])
  @@index([teamMemberId])
}

model SavedFilter {
  id          String   @id @default(cuid())
  name        String
  projectId   String?
  /// JSON TaskFilters (+ optional scope flags)
  filtersJson String
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Notification {
  id           String      @id @default(cuid())
  teamMemberId String?
  taskId       String?
  title        String
  body         String      @default("")
  kind         String      @default("info")
  readAt       DateTime?
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  task         Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([teamMemberId, createdAt])
  @@index([readAt])
}

model StatusHistory {
  id             String   @id @default(cuid())
  taskId         String
  fromStatusId   String?
  fromStatusName String   @default("")
  toStatusId     String
  toStatusName   String
  changedAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus     Status?  @relation("StatusHistoryFrom", fields: [fromStatusId], references: [id], onDelete: SetNull)
  toStatus       Status   @relation("StatusHistoryTo", fields: [toStatusId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([taskId, changedAt])
}

/// Flow adjustments after a task has already reached UAT or PRD.
model PostReleaseChange {
  id             String   @id @default(cuid())
  taskId         String
  changeType     String
  fromValue      String   @default("")
  toValue        String   @default("")
  reason         String
  afterMilestone String
  changedAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([taskId, changedAt])
}

model Subtask {
  id          String            @id @default(cuid())
  taskId      String
  name        String
  isDone      Boolean           @default(false)
  sortOrder   Int               @default(0)
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignments SubtaskAssignee[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([taskId, sortOrder])
}

model SubtaskAssignee {
  id           String     @id @default(cuid())
  subtaskId    String
  teamMemberId String
  sortOrder    Int        @default(0)
  subtask      Subtask    @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([subtaskId, teamMemberId])
  @@index([subtaskId, sortOrder])
}

model TaskAssignee {
  id           String     @id @default(cuid())
  taskId       String
  teamMemberId String
  sortOrder    Int        @default(0)
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([taskId, teamMemberId])
  @@index([taskId, sortOrder])
}
